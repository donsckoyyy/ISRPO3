{
  "name": "smart-breaker",
  "displayName": "Smart Breaker",
  "description": "Напоминает делать перерывы, если ты слишком долго пишешь код",
  "version": "0.0.1",
  "publisher": "donsckoyyy",
  "repository": {
    "type": "git",
    "url": "https://github.com/donsckoyyy/ISRPO3"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartBreaker.status",
        "title": "Smart Breaker: Показать статус"
      },
      {
        "command": "smartBreaker.reset",
        "title": "Smart Breaker: Сбросить таймер (тестовый режим)"
      }
    ],
    "configuration": {
      "title": "Smart Breaker",
      "properties": {
        "smartBreaker.workMinutes": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "description": "Сколько минут можно работать до первого напоминания."
        },
        "smartBreaker.idleMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Сколько минут без набора текста считается началом перерыва."
        },
        "smartBreaker.breakMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Сколько минут должен длиться перерыв, чтобы его засчитать."
        },
        "smartBreaker.escalationMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Через сколько минут игнорирования напоминание становится настойчивее."
        },
        "smartBreaker.testMode": {
          "type": "boolean",
          "default": false,
          "description": "Тестовый режим: все значения в минутах считаются секундами, доступна команда сброса."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
